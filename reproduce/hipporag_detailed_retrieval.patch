+def _max_in_flight() -> int:
+    raw = os.getenv("HIPPORAG_LLM_MAX_IN_FLIGHT", os.getenv("PATHCONDRAG_LLM_MAX_IN_FLIGHT", "8"))
+    try:
+        value = int(raw)
+    except ValueError:
+        value = 8
+    if not 1 <= value <= 8:
+        raise ValueError("LLM HTTP concurrency must be between 1 and 8.")
+    return value
+
+
+LLM_MAX_IN_FLIGHT = _max_in_flight()
+_LLM_HTTP_SEMAPHORE = threading.BoundedSemaphore(LLM_MAX_IN_FLIGHT)
