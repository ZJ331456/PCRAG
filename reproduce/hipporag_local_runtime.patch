+        chat_kwargs["enable_thinking"] = False
+        extra_body["chat_template_kwargs"] = chat_kwargs
+        params["extra_body"] = extra_body
+    return params
+
+
+def bounded_retry(func):
+    @functools.wraps(func)
+    def wrapper(self, *args, **kwargs):
+        max_attempts = max(1, self.max_retries + 1)
+        for attempt in range(max_attempts):
+            try:
+                return func(self, *args, **kwargs)
+            except Exception as exc:
+                retryable = isinstance(exc, openai.APIConnectionError) or (
+                    isinstance(exc, openai.APIStatusError)
+                    and (exc.status_code in (408, 409, 429) or exc.status_code >= 500)
+                )
+                if not retryable or attempt + 1 == max_attempts:
+                    _increment_stat(self, "failures")
+                    raise
+                _increment_stat(self, "retries")
+                delay = min(16.0, 2.0 ** attempt)
+                logger.warning("Retryable LLM error (attempt %s/%s, sleep %.1fs): %s", attempt + 1, max_attempts, delay, exc)
+                time.sleep(delay)
+    return wrapper
+
