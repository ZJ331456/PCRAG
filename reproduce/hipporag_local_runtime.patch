+def select_sample_indices(total, sample_size, sample_seed, indices_file=None):
+    if sample_size < 0:
+        raise ValueError("sample_size must be nonnegative")
+    if indices_file:
+        payload = json.loads(Path(indices_file).read_text(encoding="utf-8"))
+        indices = payload.get("selected_indices") if isinstance(payload, dict) else payload
+        if not isinstance(indices, list) or not indices:
+            raise ValueError("sample_indices_file must contain a non-empty list of original indices")
+        if any(type(index) is not int or not 0 <= index < total for index in indices):
+            raise ValueError("sample_indices_file contains an invalid dataset index")
+        if len(indices) != len(set(indices)):
+            raise ValueError("sample_indices_file contains duplicate indices")
+        if sample_size > 0 and len(indices) != min(sample_size, total):
+            raise ValueError("sample_indices_file length does not match sample_size")
+        return indices
+    if 0 < sample_size < total:
+        return sorted(random.Random(sample_seed).sample(range(total), sample_size))
+    return list(range(total))
+
