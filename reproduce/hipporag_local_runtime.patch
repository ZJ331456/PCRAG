+def detailed_result(solution, sample, query_index, gold_docs, gold_answers, result_top_k=10, candidate_output_top_k=200):
+    """Evaluation metadata is attached after ranking and never enters retrieval."""
+    solution.gold_docs = gold_docs
+    solution.gold_answers = gold_answers
+    row = solution.to_dict(top_k=result_top_k)
+    all_docs = list(solution.docs)
+    gold = list(dict.fromkeys(gold_docs or []))
+    metrics = {
+        f"Recall@{k}": (len(set(all_docs[:k]).intersection(gold)) / len(gold) if gold else 0.0)
+        for k in (1, 2, 5, 10, 20, 200)
+    }
+    ranks = {doc: idx + 1 for idx, doc in reversed(list(enumerate(all_docs)))}
+    decomposition = sample.get("question_decomposition")
+    row.update({
+        "query_index": query_index,
+        "sample_id": sample.get("id", sample.get("_id", query_index)),
+        "benchmark_hops": len(decomposition) if isinstance(decomposition, list) else None,
+        "candidate_docs": all_docs[:candidate_output_top_k],
+        "candidate_doc_scores": (
+            [float(score) for score in solution.doc_scores[:candidate_output_top_k]]
+            if solution.doc_scores is not None else None
+        ),
+        "retrieval_metrics": metrics,
+        "gold_document_ranks": [{"doc": doc, "rank": ranks.get(doc)} for doc in gold],
+        "all_gold_in_top5": bool(gold) and set(gold).issubset(all_docs[:5]),
+        "all_gold_in_top10": bool(gold) and set(gold).issubset(all_docs[:10]),
+        "retrieval_trace": getattr(solution, "retrieval_diagnostics", None) or {},
+    })
+    return row
